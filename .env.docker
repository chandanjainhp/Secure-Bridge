# Docker Environment Variables
# Copy this file to .env and update with your actual values

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-long-change-this

# ============================================
# Encryption Configuration
# ============================================
ENCRYPTION_KEY=your-32-character-encryption-key-change-this-to-random

# ============================================
# Email Configuration (Gmail SMTP)
# ============================================
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=Secure Bridge <your-email@gmail.com>

# ============================================
# Optional: Use MongoDB Atlas instead of local
# ============================================
# Uncomment and set if using MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
# DB_NAME=BACKEND

# ============================================
# Optional: Use Upstash Redis instead of local
# ============================================
# Uncomment and set if using Upstash Redis:
# REDIS_URL=rediss://default:your-password@your-redis.upstash.io:6379
