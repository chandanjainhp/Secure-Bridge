{
  "name": "secure-bridge-backend",
  "version": "1.0.0",
  "description": "Secure API key management backend with FHE integration",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:basic": "node src/index.js",
    "start:unified": "node src/index.js",
    "dev": "nodemon src/index.js",
    "dev:basic": "nodemon src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:mcp": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/tests/mcp.test.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "build": "echo 'No build step needed for Node.js'",
    "db:seed": "node src/scripts/seedDatabase.js",
    "db:reset": "node src/scripts/resetDatabase.js",
    "verify": "node ../scripts/verify-project.mjs"
  },
  "keywords": [
    "api-key-management",
    "jwt-authentication",
    "mongodb",
    "express",
    "encryption",
    "rate-limiting",
    "security"
  ],
  "author": "Secure Bridge Team",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/google": "^2.0.9",
    "@ai-sdk/openai": "^4.0.42",
    "@modelcontextprotocol/inspector": "^0.16.5",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "ai": "^7.0.66",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "express-slow-down": "^2.0.3",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.14",
    "redis": "^4.7.0",
    "winston": "^3.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "eslint": "^9.34.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
