{
  "name": "secure-bridge-backend",
  "version": "1.0.0",
  "description": "Secure API key management backend with FHE integration",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/server-unified.js",
    "start:basic": "node src/index.js",
    "start:mcp": "node src/server-mcp.js",
    "start:unified": "ENABLE_MCP=true node src/server-unified.js",
    "start:fhe-mcp": "node --loader ts-node/esm src/fhe-mcp-server.ts",
    "start:fhe-http": "node src/fhe-mcp-http-wrapper.js",
    "dev": "nodemon src/server-unified.js",
    "dev:basic": "ENABLE_MCP=false nodemon src/server-unified.js",
    "dev:mcp": "ENABLE_MCP=true nodemon src/server-unified.js",
    "dev:mcp-only": "nodemon src/server-mcp.js",
    "dev:fhe-mcp": "nodemon --exec \"node --loader ts-node/esm\" src/fhe-mcp-server.ts",
    "dev:fhe-http": "nodemon src/fhe-mcp-http-wrapper.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:mcp": "jest src/tests/mcp.test.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "build": "echo 'No build step needed for Node.js'",
    "db:seed": "node src/scripts/seedDatabase.js",
    "db:reset": "node src/scripts/resetDatabase.js"
  },
  "keywords": [
    "api-key-management",
    "jwt-authentication",
    "mongodb",
    "express",
    "encryption",
    "rate-limiting",
    "security"
  ],
  "author": "Secure Bridge Team",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/google": "^2.0.9",
    "@eslint/js": "^9.34.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/inspector": "^0.16.5",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/typography": "^0.5.16",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.8",
    "@vitejs/plugin-react": "^5.0.1",
    "ai": "^5.0.24",
    "autoprefixer": "^10.4.21",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.1.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "express-slow-down": "^2.0.3",
    "express-validator": "^7.1.0",
    "globals": "^16.3.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.18.0",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "redis": "^4.7.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "uuid": "^9.0.1",
    "vite": "^7.1.3",
    "winston": "^3.13.1",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "eslint": "^9.34.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js",
      "!src/scripts/**",
      "!src/config/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/setup.js"
    ]
  }
}
